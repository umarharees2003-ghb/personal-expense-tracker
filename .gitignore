# =============================================================================
# Root .gitignore for Finora - Personal Expense Tracker
# =============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build Outputs
dist/
build/
target/
*.class

# Environment variables & Local Credentials
.env
.env.*
!.env.example
application-local.properties

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# IDE and Editor configuration
.idea/
.vscode/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
.springBeans
.sts4-cache

# Operating System Files
.DS_Store
Thumbs.db

