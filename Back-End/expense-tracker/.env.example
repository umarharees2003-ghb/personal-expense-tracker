# =============================================================================
# Finora Backend Environment Variables Template
# Copy to your environment or deployment settings. Do not commit actual secrets!
# =============================================================================

# Database Credentials
DB_URL=jdbc:mysql://localhost:3306/expense_tracker?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=replace-with-your-local-mysql-password

# JWT Security
# Must be at least 32 UTF-8 bytes for HMAC-SHA256 signature
JWT_SECRET=your_minimum_32_bytes_super_secure_random_secret_here
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origin
CORS_ALLOWED_ORIGIN=http://localhost:5173,http://localhost:4173

# Flyway & Hibernate
FLYWAY_ENABLED=true
HIBERNATE_DDL_AUTO=validate
SHOW_SQL=false
